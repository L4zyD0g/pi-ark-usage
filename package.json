{
  "name": "pi-ark-usage",
  "version": "0.1.6",
  "description": "Show Volcengine Ark Coding Plan / Agent Plan usage in the pi TUI (AK/SK OpenAPI)",
  "keywords": [
    "pi",
    "pi-package",
    "extension",
    "volcengine",
    "ark",
    "openapi",
    "coding-plan",
    "usage",
    "quota",
    "tui"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "README.md"
  ],
  "engines": {
    "node": ">=23.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "main": "extensions/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/ts-resolve-hook.mjs --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@volcengine/openapi": "^1.36.2"
  }
}
